      "requirement": "All documents must have a unique identifier, version, status, and classification.",
      "severity": "MEDIUM",
      "penalty": 4,
      "document_type": "ALL",
      "check_type": "METADATA_INTEGRITY",
      "mandatory": true
    },
    {
      "id": "APP-001",
      "category": "Approval",
