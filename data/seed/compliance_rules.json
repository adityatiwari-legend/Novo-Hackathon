{
  "rules_metadata": {
    "version": "2.0.0",
    "lifecycle_scope": "Novo Life MES PAS-X (SYS-MES-001) Computerized System Validation",
    "regulatory_frameworks": ["21 CFR Part 11", "EU Annex 11", "GAMP 5 Category 4", "ALCOA+", "ICH Q9"]
  },
  "rules": [
    {
      "id": "DOC-001",
      "category": "Document Control",
      "requirement": "User Requirements Specification (URS) must exist and be approved.",
      "severity": "HIGH",
      "penalty": 15,
      "check_type": "DOCUMENT_REQUIRED",
      "params": {
        "document_type": "URS"
      },
      "mandatory": true
    },
    {
      "id": "DOC-002",
      "category": "Document Control",
      "requirement": "IT Risk Assessment (ITRA) must exist.",
      "severity": "HIGH",
      "penalty": 15,
      "check_type": "DOCUMENT_REQUIRED",
      "params": {
        "document_type": "ITRA"
      },
      "mandatory": true
    },
    {
      "id": "DOC-003",
      "category": "Document Control",
      "requirement": "Implementation Report (IREP) must exist.",
      "severity": "HIGH",
      "penalty": 15,
      "check_type": "DOCUMENT_REQUIRED",
      "params": {
        "document_type": "IREP"
      },
      "mandatory": true
    },
    {
      "id": "DOC-004",
      "category": "Document Control",
      "requirement": "Active documents must not be past their mandatory review date.",
      "severity": "MEDIUM",
      "penalty": 6,
      "check_type": "DOCUMENT_CURRENT",
      "params": {},
      "mandatory": true
    },
    {
      "id": "TRC-001",
      "category": "Traceability",
      "requirement": "Every requirement must have a verification reference.",
      "severity": "HIGH",
      "penalty": 14,
      "check_type": "REQUIREMENT_HAS_VERIFICATION",
      "params": {},
      "mandatory": true
    },
    {
      "id": "RSK-001",
      "category": "Risk Management",
      "requirement": "No unaccepted HIGH residual risks.",
      "severity": "HIGH",
      "penalty": 15,
      "check_type": "RESIDUAL_RISK_ACCEPTED",
      "params": {
        "threshold_score": 10
      },
      "mandatory": true
    },
    {
      "id": "REL-001",
      "category": "Release",
      "requirement": "Verification gate must be MET.",
      "severity": "HIGH",
      "penalty": 15,
      "check_type": "RELEASE_GATE_MET",
      "params": {
        "gate_code": "G4"
      },
      "mandatory": true
    },
    {
      "id": "REL-002",
      "category": "Release",
      "requirement": "Release Readiness gate must be MET.",
      "severity": "HIGH",
      "penalty": 10,
      "check_type": "RELEASE_GATE_MET",
      "params": {
        "gate_code": "G5"
      },
      "mandatory": true
    },
    {
      "id": "REL-003",
      "category": "Release",
      "requirement": "Operational Handover gate must be MET.",
      "severity": "MEDIUM",
      "penalty": 4,
      "check_type": "RELEASE_GATE_MET",
      "params": {
        "gate_code": "G6"
      },
      "mandatory": true
    }
  ]
