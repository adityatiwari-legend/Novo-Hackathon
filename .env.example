# AI Model Configuration (Optional: fallback deterministic reasoning works offline)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database (Default: local SQLite with zero setup, or PostgreSQL in Docker)
DATABASE_URL=sqlite:///./gxp_copilot.db

# Storage Directories
VECTOR_STORE_PATH=data/vector_store
UPLOAD_DIR=data/uploads

# Security Secret
SECRET_KEY=gxp-secret-key-novo-hackathon-2026-audit-ready-secure

# Hackathon Demo & Mock Enterprise Flags
DEMO_MODE=true
MOCK_SERVICENOW=true
MOCK_VAULT=true
MOCK_IAM=true
MOCK_MONITORING=true
